generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id         Int           @id @default(autoincrement())
  name       String
  email      String?       @unique // Optional for students, required for admins
  rollNo     String?       @unique // Required for students
  department String?
  password   String
  role       String        @default("student")
  requests   BookRequest[]
  issues     Issue[]
}

model Book {
  id       Int           @id @default(autoincrement())
  title    String
  author   String
  category String
  status   String        @default("Available")
  cover    String
  issues   Issue[]
  requests BookRequest[]
}

model Student {
  id           Int     @id @default(autoincrement())
  name         String
  rollNo       String  @unique
  department   String
  activeIssues Int     @default(0)
  issues       Issue[]
}

model Issue {
  id        Int      @id @default(autoincrement())
  bookId    Int
  userId    Int? // For registered students/users
  studentId Int? // For legacy/manual student entries
  issueDate DateTime @default(now())
  dueDate   DateTime
  status    String   @default("Active")

  book    Book     @relation(fields: [bookId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])
  student Student? @relation(fields: [studentId], references: [id])
}

model BookRequest {
  id        Int      @id @default(autoincrement())
  bookId    Int
  userId    Int
  status    String   @default("Pending") // Pending, Approved, Rejected
  createdAt DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model Activity {
  id        Int      @id @default(autoincrement())
  type      String
  text      String
  createdAt DateTime @default(now())
}
